# .env.local — copy this file and fill in your values
# Never commit .env.local to git

# ── Supabase ──────────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — server-only, NEVER expose to the client
# Found in Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App URL ───────────────────────────────────────────────────
# Used for auth redirect URLs. Payment return URLs are derived
# from the domain the buyer is actually on, so tips work on both
# geopoly.vercel.app and justgimmeadolla.com with no extra config.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: NEXT_PUBLIC_SITE_URL=https://geopoly.vercel.app

# ── Stripe (card tips) ────────────────────────────────────────
# Found in Stripe Dashboard → Developers → API keys
# Server-only, NEVER expose to the client. Use sk_test_… locally
# and sk_live_… in Vercel Production.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Found in Stripe Dashboard → Developers → Webhooks → your endpoint
# Endpoint URL: https://geopoly.vercel.app/api/tip/stripe/webhook
# (use https://justgimmeadolla.com/api/tip/stripe/webhook if that
# is the domain in production — one endpoint per live domain)
# Events to send: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ── PayPal (PayPal tips) ──────────────────────────────────────
# Found in developer.paypal.com → Apps & Credentials → your app
# Server-only, NEVER expose to the client.
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_client_secret_here

# sandbox while testing, live in Vercel Production.
# The sandbox app and the live app have DIFFERENT credentials.
PAYPAL_MODE=sandbox

# ── Transcription (optional) ──────────────────────────────────
# Server-only. When set, every voice story is transcribed
# automatically on submission (Whisper), and the admin queue
# gets Transcribe / Transcribe-all buttons for backfilling
# existing stories. Without it, transcripts are pasted in
# manually from the admin queue.
OPENAI_API_KEY=sk_your_key_here
